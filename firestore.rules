rules_version = '2';

// Seizure Tracker – Firestore security rules
// Access is granted per child. Every read and write is checked here, on Google's servers,
// so a modified copy of the app cannot get around these rules.
//
// Roles (stored in children/{childId}.roles as { uid: role }):
//   owner  – everything for that child: care plan, people, delete
//   carer  – log seizures, edit and delete entries
//   logger – log seizures; edit only their own entries for 24 hours
//   viewer – read only

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function childDoc(cid) { return get(/databases/$(database)/documents/children/$(cid)); }
    function roleFor(cid) { return childDoc(cid).data.roles.get(uid(), ''); }
    function hasRole(cid, roles) { return signedIn() && roleFor(cid) in roles; }

    // ---------- people ----------
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ---------- children ----------
    match /children/{cid} {

      // Readable only by people with a role for this child.
      // (Matches the app's query: where("roles.<uid>", "in", [...roles]).)
      allow read: if signedIn()
        && resource.data.roles[uid()] in ['owner', 'carer', 'logger', 'viewer'];

      // Anyone signed in can set up a child, as its only owner.
      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.roles.keys().hasOnly([uid()])
        && request.resource.data.roles[uid()] == 'owner'
        && request.resource.data.memberNames is map;

      // Owners can change anything but must stay an owner themselves.
      function ownerUpdate() {
        return resource.data.roles.get(uid(), '') == 'owner'
          && request.resource.data.roles.get(uid(), '') == 'owner'
          && request.resource.data.createdBy == resource.data.createdBy;
      }

      // Someone with a valid, unused invite adds only themselves, with the invite's role.
      function joining() {
        let inv = get(/databases/$(database)/documents/invites/$(request.resource.data.inviteUsed)).data;
        return !(uid() in resource.data.roles)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'memberNames', 'inviteUsed'])
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid()])
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([uid()])
          && inv.childId == cid
          && inv.usedBy == null
          && inv.expiresAt > request.time
          && request.resource.data.roles[uid()] == inv.role;
      }

      // Non-owners can remove themselves.
      function leaving() {
        return resource.data.roles.get(uid(), '') in ['carer', 'logger', 'viewer']
          && !(uid() in request.resource.data.roles)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'memberNames'])
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid()]);
      }

      allow update: if signedIn() && (ownerUpdate() || joining() || leaving());
      allow delete: if signedIn() && resource.data.roles.get(uid(), '') == 'owner';

      // ---------- seizure records ----------
      match /seizures/{sid} {
        function validRecord() {
          let d = request.resource.data;
          return d.start is number
            && d.durationSec is number && d.durationSec >= 0 && d.durationSec < 86400
            && d.updatedBy == uid()
            && d.updatedAt == request.time;
        }

        allow read: if hasRole(cid, ['owner', 'carer', 'logger', 'viewer']);

        allow create: if hasRole(cid, ['owner', 'carer', 'logger'])
          && validRecord()
          && request.resource.data.by == uid()
          && request.resource.data.createdAt == request.time;

        allow update: if validRecord()
          && request.resource.data.by == resource.data.by
          && request.resource.data.createdAt == resource.data.createdAt
          && (hasRole(cid, ['owner', 'carer'])
              || (hasRole(cid, ['logger'])
                  && resource.data.by == uid()
                  && request.time < resource.data.createdAt + duration.value(24, 'h')));

        allow delete: if hasRole(cid, ['owner', 'carer']);
      }

      // ---------- change history (append-only) ----------
      match /audit/{aid} {
        allow read: if hasRole(cid, ['owner']);
        allow create: if hasRole(cid, ['owner', 'carer', 'logger'])
          && request.resource.data.by == uid()
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // ---------- invites ----------
    // The invite id is a long random token, shared as a link. It can be read by anyone signed in
    // who has the link, but invites can never be listed or searched.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && childDoc(request.resource.data.childId).data.roles.get(uid(), '') == 'owner'
        && request.resource.data.createdBy == uid()
        && request.resource.data.usedBy == null
        && request.resource.data.role in ['owner', 'carer', 'logger', 'viewer']
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');

      // Used once, by the person accepting it.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == uid();

      allow delete: if signedIn() && resource.data.createdBy == uid();
    }

    // Everything else is closed.
  }
}

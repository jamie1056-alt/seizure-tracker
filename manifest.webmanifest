{
  "name": "Seizure Tracker",
  "short_name": "Seizure Tracker",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#171b38",
  "theme_color": "#2a2f6e",
  "icons": [
    {
      "src": "icon-v2-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-v2-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Start seizure timer",
      "short_name": "Start timer",
      "url": "./index.html?start=1",
      "icons": [
        {
          "src": "icon-start-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "icon-start-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}